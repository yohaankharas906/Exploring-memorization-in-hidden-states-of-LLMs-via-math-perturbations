.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]

# Local model weights are too large for GitHub and can be re-downloaded.
models/
*.safetensors
*.ckpt
*.bin
*.pt
*.pth

# Generated model outputs; keep these local unless intentionally published.
data/
datasets/
results/*
*.jsonl

# Published datasets and selected samples.
!MATH-Perturb/math_perturb/
!MATH-Perturb/math_perturb/*.jsonl
!results/
!results/interesting_samples*.jsonl
!results/math_perturb_*_qwen.jsonl

# Avoid committing nested repository metadata.
MATH-Perturb/.git/
MATH-Perturb/.git-local-backup/
